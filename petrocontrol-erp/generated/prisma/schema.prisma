generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String   @id @default(uuid())
  nombre    String
  apellido  String
  email     String   @unique
  password  String // Aquí guardaremos la contraseña hasheada (ej. con bcrypt)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
