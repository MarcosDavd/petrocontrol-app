# Copia este archivo a .env y ajusta los valores.

# Conexión a PostgreSQL (docker-compose.yml en la raíz del repo).
# Para Neon/producción usa la cadena con "Connection pooling" activado.
DATABASE_URL="postgresql://admin:admin@localhost:5434/petrocontrol?schema=public"

# Secreto para firmar la sesión (32+ caracteres). Genera uno con: openssl rand -base64 48
SESSION_SECRET="cambia-esto-por-un-texto-aleatorio-de-32-caracteres-o-mas"

# Usuario dueño que crea el seed. En una base local, si se omiten, se usa
# dueno@petrocontrol.pe / Admin123!. En una base remota ADMIN_PASSWORD es obligatoria (mín. 10 caracteres).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
